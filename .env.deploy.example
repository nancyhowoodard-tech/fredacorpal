# Spaceship cPanel SSH Deployment Configuration
# This file is ignored by git to protect your server credentials.

# Your website domain or server IP
CPANEL_HOST=fredacorpal.world

# Your cPanel account username (visible in the top-right of your cPanel screen)
CPANEL_USER=your_cpanel_username

# SSH Port on Spaceship / Namecheap hosting (default is 21098, fallback is 22)
CPANEL_PORT=21098

# Remote target folder on your cPanel server
CPANEL_PATH=/home/your_cpanel_username/fredacorpal

# Private key generated for deployment
SSH_KEY=/Users/user/.ssh/fredacorpal_deploy
